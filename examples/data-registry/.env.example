# Optional public configuration for the Step 3 notebook.
# Copy to .env beside the notebook only when your project names or Service vary.
# Never put an S3 key, bearer token, or password here.
REGISTRY_PROJECT=data-registry-example
REGISTRY_COLLECTION=customer-support
REGISTRY_ASSET=customer-support-faq
RHOAI_CONNECTION_NAME=data-registry-storage
REGISTRY_URL=https://feast-data-registry-data-registry.rhoai-data-registry.svc:443
REGISTRY_CA_BUNDLE=/var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt
RHOAI_CONNECTION_MOUNT=/var/run/secrets/data-registry-storage
